# .env.example - Copy this to .env and add your own values

# Database Configuration
# Local MySQL (XAMPP):    mysql+pymysql://root:@localhost:3306/user
# Railway (auto-set):     provided automatically when MySQL plugin is added
# External managed MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=mysql+pymysql://root:@localhost:3306/user

# Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Flask Configuration
SECRET_KEY=generate_a_random_secret_key_here

# Google OAuth Configuration
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here

# Session Configuration (optional, defaults to ./flask_session)
# Use /tmp/flask_session on cloud platforms
# SESSION_FILE_DIR=/tmp/flask_session

# Set to "false" when running locally over plain HTTP (e.g. XAMPP)
# Set to "true" in production (HTTPS)
SESSION_COOKIE_SECURE=true